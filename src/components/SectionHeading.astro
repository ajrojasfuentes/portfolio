---
export interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
  color: string;
}

const { eyebrow, title, subtitle, color } = Astro.props;

import { Reveal } from '@/components/ui/Reveal';
import { hexToRgba } from '@/lib/constants';
---

<Reveal client:visible>
  <div class="mb-14">
    <div class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.2em] uppercase mb-4" style={`color: ${color}`}>
      <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${color}`}></span>
      {eyebrow}
    </div>
    <div class="flex items-center gap-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-white">{title}</h2>
      <div class="h-px flex-1" style={`background: linear-gradient(to right, ${hexToRgba(color, 0.5)}, transparent)`}></div>
    </div>
    {subtitle && <p class="text-slate-400 mt-4 max-w-2xl">{subtitle}</p>}
  </div>
</Reveal>
