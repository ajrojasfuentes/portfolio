---
import { Mail, FileDown } from "lucide-react";

interface Props {
  href?: string | undefined;
  icon: "github" | "linkedin" | "mail" | "cv";
  label?: string | undefined;
  variant: "icon" | "full";
  download?: string | undefined;
}

const { href, icon, label, variant, download } = Astro.props;

// If no href is provided, don't render the button
if (!href) {
  return;
}

const isIcon = variant === "icon";
const iconSize = isIcon ? 16 : 24;
const finalIconSize = !isIcon && icon === "github" ? 28 : iconSize;
const baseClasses = `contact-link aurora btn-aurora-${variant} aurora-hover relative flex items-center overflow-hidden transition-all will-change-transform isolate`;
const iconClasses = isIcon
  ? "group/mini h-9 w-9 justify-center rounded-full border border-white/10 bg-white/5 hover:scale-110 active:scale-95"
  : "group/btn w-full justify-between rounded-xl border border-white/5 bg-transparent px-5 py-4 hover:scale-[1.02] active:scale-[0.98]";

const innerIconClasses = isIcon
  ? "relative z-10 text-indigo-300 transition-colors duration-300 group-hover/mini:text-white"
  : "text-indigo-300 transition-colors duration-300 group-hover/btn:text-white";

const textClass = !isIcon && icon === "github" ? "text-base" : "text-sm";
const ariaLabel = label || `${icon} link`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`${baseClasses} ${iconClasses}`}
  download={download}
  aria-label={ariaLabel}
>
  {
    isIcon ? (
      icon === "github" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width={finalIconSize} height={finalIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={innerIconClasses}><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
      ) : icon === "linkedin" ? (
        <svg xmlns="http://www.w3.org/2000/svg" width={finalIconSize} height={finalIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={innerIconClasses}><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
      ) : icon === "mail" ? (
        <Mail size={finalIconSize} className={innerIconClasses} />
      ) : (
        <FileDown size={finalIconSize} className={innerIconClasses} />
      )
    ) : (
      <>
        <div class="relative z-10">
          {icon === "github" ? (
            <svg xmlns="http://www.w3.org/2000/svg" width={finalIconSize} height={finalIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={innerIconClasses}><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
          ) : icon === "linkedin" ? (
            <svg xmlns="http://www.w3.org/2000/svg" width={finalIconSize} height={finalIconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={innerIconClasses}><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
          ) : icon === "mail" ? (
            <Mail size={finalIconSize} className={innerIconClasses} />
          ) : (
            <FileDown size={finalIconSize} className={innerIconClasses} />
          )}
        </div>
        <span
          class={`relative z-10 font-mono font-light tracking-widest text-slate-300 transition-colors duration-300 group-hover/btn:text-white ${textClass}`}
        >
          {label}
        </span>
      </>
    )
  }
</a>
