---
import { Mail, Phone } from "lucide-react";
import IdCardButton from "./IdCardButton.astro";
import { ACCENTS, hexToRgba } from "@/lib/constants";

interface ProfileData {
  name: string;
  titles: string[];
  email?: string | undefined;
  tel?: string | undefined;
  location?: string | undefined;
  statusText?: string | undefined;
  linkedin?: string | undefined;
  github?: string | undefined;
  cvLink?: string | undefined;
  phrase?: string | undefined;
  description?: string | undefined;
}

interface Props {
  profile: ProfileData;
}

const { profile } = Astro.props;
const {
  name,
  titles,
  email,
  tel,
  statusText,
  linkedin,
  github,
  cvLink,
  phrase,
} = profile;
---

<div
  class="relative flex w-full flex-col items-center overflow-hidden rounded-[2.5rem] border border-white/10 bg-slate-900/20 px-10 py-12 text-center shadow-xl shadow-black/30 backdrop-blur-xl transition-all duration-500 backface-hidden group-hover:border-white/20 group-hover:shadow-2xl group-hover:shadow-indigo-500/10"
  style="-webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);"
>
  {/* Halo / Resplandor Ambiental (idéntico a BentoCard) */}
  <div
    class="pointer-events-none absolute -top-20 -right-20 h-64 w-64 rounded-full opacity-20 blur-3xl transition-opacity duration-700 group-hover:opacity-40"
    style="background: rgba(124, 58, 237, 0.2);"
  >
  </div>

  {/* Lanyard Hole (Ranura para cordón) */}
  <div
    class="absolute top-4 left-1/2 z-30 h-3 w-16 -translate-x-1/2 rounded-full bg-slate-950/40 shadow-inner ring-1 ring-white/10 ring-inset"
  >
  </div>

  {/* Textura de Granulado Grueso (Noise) suavizada */}
  <div
    class="pointer-events-none absolute inset-0 z-0 opacity-[0.12] mix-blend-soft-light"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"
  >
  </div>

  {/* Relieve interno constante */}
  <div
    class="pointer-events-none absolute inset-0 z-10 rounded-[2.5rem] ring-1 ring-white/10 ring-inset"
  >
  </div>

  {/* Número de Identificación y Triángulo (Top Bar) */}
  <div
    class="relative z-20 mb-6 flex w-full items-center justify-between border-b border-white/10 pb-3"
  >
    <div class="flex items-center gap-2">
      <div
        class="drop-shadow-[0_0_4px_rgba(217,70,239,0.8)] drop-shadow-[0_0_12px_rgba(217,70,239,1)]"
      >
        <div
          id="badge-triangle-indicator"
          class="aurora h-3.5 w-3.5"
          style="clip-path: polygon(50% 100%, 0 0, 100% 0);"
        >
        </div>
      </div>
      <span
        class="font-mono text-[10px] tracking-widest text-slate-400 uppercase"
      >
        Clearance_Lvl: 09
      </span>
    </div>
    <span class="font-mono text-[11px] tracking-widest text-indigo-400">
      ID: ARF-2026-X
    </span>
  </div>

  {/* Foto con Marco Punteado */}
  <div
    class="relative z-20 mb-6 h-32 w-32 shrink-0 rounded-full border border-dashed border-white/40 p-1.5"
  >
    <img
      src="/Photo.jpg"
      alt={name}
      class="h-full w-full rounded-full object-cover shadow-inner contrast-125 grayscale-[20%]"
    />
  </div>

  {/* Nombre y Títulos Centrados */}
  <div class="relative z-20 flex w-full flex-col items-center">
    <h1
      class="font-display mb-3 text-[32px] leading-tight font-bold tracking-tight whitespace-nowrap text-white"
    >
      {name}
    </h1>

    {
      titles && titles.length > 0 && (
        <div class="mb-5 flex w-full flex-nowrap justify-center gap-1.5 px-2">
          {titles.map((title: string) => (
            <span class="inline-block rounded border border-white/10 bg-white/5 px-2.5 py-1.5 text-[9px] tracking-wider whitespace-nowrap text-slate-300 uppercase shadow-sm backdrop-blur-md">
              {title}
            </span>
          ))}
        </div>
      )
    }

    <div class="relative z-20 mb-2 flex w-full flex-col items-center gap-3">
      {/* Fila 1: Correo y Teléfono */}
      <div
        class="flex items-center justify-center gap-4 font-mono text-[11px] text-slate-300"
      >
        <a
          href={`mailto:${email}`}
          class="contact-link flex items-center gap-1.5 transition-colors hover:text-white"
        >
          <Mail size={13} className="text-indigo-400" />
          {email}
        </a>
        {
          tel && (
            <>
              <span class="text-white/20">|</span>
              <a
                href={`tel:${tel.replace(/\s+/g, "")}`}
                class="contact-link flex items-center gap-1.5 transition-colors hover:text-white"
              >
                <Phone size={13} className="text-indigo-400" />
                {tel}
              </a>
            </>
          )
        }
      </div>

      {/* Fila 2: 4 Íconos (Aurora Fluid) */}
      <div class="flex items-center justify-center gap-3">
        <IdCardButton href={linkedin} icon="linkedin" variant="icon" />
        <IdCardButton href={github} icon="github" variant="icon" />
        <IdCardButton
          href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`}
          icon="mail"
          variant="icon"
        />
        <IdCardButton
          href={cvLink}
          download="Anthony_Rojas_CV.pdf"
          icon="cv"
          variant="icon"
        />
      </div>
    </div>
  </div>

  {/* Separador */}
  <div class="relative z-20 my-4 w-full border-t border-white/10"></div>

  {/* Cita */}
  {
    phrase && (
      <div class="relative z-20 px-2">
        <p class="text-base leading-relaxed text-slate-300 italic">
          <span class="mr-1 font-serif text-xl leading-none text-indigo-400">
            "
          </span>
          {phrase}
          <span class="ml-1 font-serif text-xl leading-none text-indigo-400">
            "
          </span>
        </p>
      </div>
    )
  }

  {/* Separador */}
  <div class="relative z-20 mt-4 mb-6 w-full border-t border-white/10"></div>

  {
    /* Estado Opcional (Tag "Open to Works and Projects" con efecto de parpadeo y luminosidad) */
  }
  {
    statusText && (
      <div
        class="relative z-20 mb-2 inline-flex items-center gap-2.5 rounded-full border px-4 py-1.5 font-mono text-[11px] tracking-wider uppercase shadow-lg shadow-teal-500/10 backdrop-blur-md transition-all duration-300 hover:border-teal-400/50 hover:shadow-teal-500/20"
        style={`border-color: ${hexToRgba(ACCENTS.home, 0.35)}; color: ${ACCENTS.home}; background-color: ${hexToRgba(ACCENTS.home, 0.1)}`}
      >
        <span class="relative flex h-2.5 w-2.5 items-center justify-center">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
            style={`background-color: ${ACCENTS.home}`}
          />
          <span
            class="relative inline-flex h-2 w-2 rounded-full shadow-[0_0_8px_rgba(45,212,191,0.9)]"
            style={`background-color: ${ACCENTS.home}`}
          />
        </span>
        <span class="font-medium drop-shadow-[0_0_6px_rgba(45,212,191,0.4)]">
          {statusText}
        </span>
      </div>
    )
  }

  {/* Código de Barras Decorativo */}
  <div
    class="relative z-20 mt-6 flex w-full origin-top scale-110 flex-col items-center opacity-60"
  >
    <div class="flex h-10 items-end gap-[2px]">
      <div class="h-full w-1 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-full w-1.5 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-full w-1 bg-slate-400"></div>
      <div class="h-full w-2 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-full w-1 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-[80%] w-1.5 bg-slate-400"></div>
      <div class="h-full w-1 bg-slate-400"></div>
      <div class="h-full w-2 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-[90%] w-1 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
      <div class="h-full w-1.5 bg-slate-400"></div>
      <div class="h-full w-1 bg-slate-400"></div>
      <div class="h-full w-0.5 bg-slate-400"></div>
    </div>
    <span class="mt-1 font-mono text-[8.5px] tracking-[0.2em] text-slate-500">
      8943-XYZ-90210
    </span>
  </div>

  {/* Indicador de Flip */}
  <div class="absolute right-5 bottom-5 z-20 animate-pulse text-indigo-400/70">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
      <path d="M21 3v5h-5"></path>
    </svg>
  </div>
</div>
