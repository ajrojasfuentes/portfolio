</section>

<style>
  /* Aplicar fuente Nerd Font DejaVu Sans Mono a TODO el texto del badge */
  #badge-card,
  #badge-card * {
    font-family:
      "DejaVuSansM Nerd Font", "DejaVuSansMono Nerd Font", "DejaVu Sans Mono",
      monospace !important;
  }

  /* ---- Efecto Nebula Hover para Botones ---- */
  .nebula-flow-wrap {
    overflow: hidden;
  }
  .nebula-flow {
    position: absolute;
    inset: -30% -60%;
    background: linear-gradient(
      90deg,
      #7c3aed 0%,
      #a855f7 16%,
      #e879f9 33%,
      #f472b6 50%,
      #2dd4bf 66%,
      #38bdf8 83%,
      #7c3aed 100%
    );
    background-size: 200% 100%;
    background-repeat: repeat-x;
    filter: blur(40px); /* Desenfoque ajustado para botones */
    mix-blend-mode: screen;
    opacity: 0.6;
    animation: flow-right-to-left 32s linear infinite;
  }
  @keyframes flow-right-to-left {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: -200% 50%;
    }
  }

  .nebula-blob-layer {
    overflow: hidden;
  }
  .nebula-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(20px); /* Desenfoque ajustado para botones */
    mix-blend-mode: screen;
    opacity: 0.75;
    will-change: transform, border-radius;
  }
  .blob-1 {
    width: 52%;
    height: 52%;
    top: -10%;
    left: -6%;
    background: radial-gradient(circle at 35% 35%, #a855f7, transparent 70%);
    animation:
