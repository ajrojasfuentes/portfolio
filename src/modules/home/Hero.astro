  }

  /* Clases de 3D / Flip */
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Estado Volteado */
  #badge-card.is-flipped {
    transform: rotateY(-180deg);
  }
</style>

<script>
  // Lógica para voltear el gafete y para seguimiento interactivo 3D con el cursor
  const badgeContainer = document.getElementById("badge-container");
  const badgeTilt = document.getElementById("badge-tilt");
  const badgeCard = document.getElementById("badge-card");

  if (badgeContainer && badgeTilt && badgeCard) {
    // 1. Flip de la tarjeta al hacer click
    badgeContainer.addEventListener("click", () => {
      badgeCard.classList.toggle("is-flipped");
    });

    // 1b. Evitar que el flip ocurra al dar click en los enlaces de contacto
    const contactLinks = document.querySelectorAll(".contact-link");
    contactLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        e.stopPropagation();
      });
    });

    // Preferencia de sistema de reducir movimiento
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // 2. Inclinación 3D dinámica basada en TiltCard
    if (!reducedMotion) {
      badgeContainer.addEventListener("mousemove", (e) => {
        const rect = badgeContainer.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        // Exact same logic as TiltCard.tsx but with reduced intensity
        const x = (e.clientX - rect.left - rect.width / 2) / 35;
        const y = -(e.clientY - rect.top - rect.height / 2) / 35;

        const rotateX = Math.max(-5, Math.min(5, y));
        const rotateY = Math.max(-5, Math.min(5, x));

        badgeTilt.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });

      // 3. Restaurar la inclinación cuando el cursor sale
      badgeContainer.addEventListener("mouseleave", () => {
        badgeTilt.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    }
  }
</script>
