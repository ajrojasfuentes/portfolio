---
import { getEntry } from "astro:content";
import IdCard from "@/components/ui/idcard/IdCard.astro";
import { HeroAboutCard } from "@/components/ui/bento/HeroAboutCard";
import { HeroMoreCard } from "@/components/ui/bento/HeroMoreCard";

const profileEntry = await getEntry("about", "profile");
if (!profileEntry) {
  throw new Error("Profile entry not found in src/content/about/profile.mdx");
}

const profile = profileEntry.data;
---

<section
  id="home"
  class="relative flex min-h-[85vh] items-center justify-center pt-8 pb-16 md:pt-14"
>
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 md:px-6">
    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
      {/* Columna Izquierda: IDCard (Espacio grande, 5 columnas en desktop) */}
      <div class="flex justify-center lg:col-span-5">
        <IdCard profile={profile} />
      </div>

      {
        /* Columna Derecha: 2 Espacios (7 columnas en desktop) alineados en altura con el IDCard */
      }
      <div
        class="flex h-full min-h-0 flex-col justify-between gap-6 lg:col-span-7"
      >
        <HeroAboutCard client:load profile={profile} />
        <HeroMoreCard client:load />
      </div>
    </div>
  </div>
</section>
