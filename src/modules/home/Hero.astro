---
import { getEntry } from "astro:content";
import IdCard from "@/components/ui/idcard/IdCard.astro";
import HeroBackground from "@/components/layout/HeroBackground";
import HeroPresentation from "@/components/ui/hero/HeroPresentation";

const profileEntry = await getEntry("about", "profile");
if (!profileEntry) {
  throw new Error("Profile entry not found in src/content/about/profile.mdx");
}

const profile = profileEntry.data;
---

<section
  id="home"
  class="relative flex min-h-screen items-center justify-center pt-8 pb-[10vh] md:pt-14"
>
  <HeroBackground client:load />
  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 md:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Columna Izquierda: ID Card */}
      <div class="w-full flex justify-center lg:justify-end">
        <div class="w-full max-w-[480px]">
          <IdCard profile={profile} />
        </div>
      </div>
      
      {/* Columna Derecha: Presentación Animada */}
      <div class="w-full flex justify-center lg:justify-start">
        <HeroPresentation client:load />
      </div>
    </div>
  </div>
</section>
