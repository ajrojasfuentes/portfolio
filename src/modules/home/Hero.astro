  @media (prefers-reduced-motion: reduce) {
    .nebula-blob,
    .nebula-flow {
      animation: none !important;
    }
  }

  /* Animación emisiva y fluida "Neon Nebula" en diagonal */
  @keyframes fluid-nebula {
    0% {
      background-position: 100% 0%;
    }
    50% {
