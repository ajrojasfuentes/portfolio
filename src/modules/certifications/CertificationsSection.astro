---
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { Reveal } from "@/components/ui/Reveal";
import { ACCENTS, hexToRgba } from "@/lib/constants";
import { getSortedCertifications } from "@/lib/content";
import { ShieldCheck } from "lucide-react";

const certifications = await getSortedCertifications();
---

<section id="certifications" class="py-16 md:py-20">
  <SectionHeading
    eyebrow="Credentials"
    title="Certifications"
    color={ACCENTS.certifications}
  />
  <div class="grid gap-4 sm:gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      certifications.map((cert, i) => (
        <Reveal client:visible delay={i * 80}>
          <div
            class="flex h-full flex-col rounded-2xl border p-4 md:p-5 transition-transform hover:-translate-y-1 hover:border-rose-500/30"
            style="background-color: var(--color-surface); border-color: var(--color-border-soft)"
          >
            <div class="mb-4 flex items-start justify-between">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-xl shadow-inner"
                style={`background-color: ${hexToRgba(ACCENTS.certifications, 0.12)}`}
              >
                <ShieldCheck size={20} color={ACCENTS.certifications} />
              </span>
            </div>
            <h3 class="font-display mb-1 text-sm md:text-base leading-snug font-bold text-white">
              {cert.data.name}
            </h3>
            <p class="mb-2 text-xs md:text-sm text-slate-400">{cert.data.issuer}</p>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>
