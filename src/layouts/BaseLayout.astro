---
import "@/styles/globals.css";
import "aurora-fluid/aurora.css";
import Nav from "@/components/layout/Nav";
import StellarWrapper from "@/components/layout/StellarWrapper";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Anthony Rojas Fuentes — AI Engineer, Data Platform Engineer, and Full-Stack Developer.",
  image = "/Photo.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://ajrojasfuentes.dev");
const socialImageURL = new URL(image, canonicalURL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#010508" />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    {/* Google Fonts Preconnect & Stylesheets */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="portfolio-shell min-h-screen">
    <StellarWrapper client:idle />
    <Nav client:load />
    <main class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 md:pt-10">
      <slot />
    </main>
    <footer
      class="mt-20 border-t py-8"
      style="border-color: var(--color-border-soft)"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-sm text-slate-500 md:flex-row"
      >
        <p>
          © {new Date().getFullYear()} Anthony Rojas Fuentes. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
