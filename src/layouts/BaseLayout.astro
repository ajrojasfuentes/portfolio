---
import "@/styles/globals.css";
import Nav from "@/components/layout/Nav";
import StellarWrapper from "@/components/layout/StellarWrapper";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Anthony Rojas Fuentes - Data Automation & AI Engineer"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="portfolio-shell min-h-screen">
    <StellarWrapper client:idle />
    <Nav client:load />
    <main class="mx-auto max-w-6xl px-6 pt-10">
      <slot />
    </main>
    <footer
      class="mt-20 border-t py-8"
      style="border-color: var(--color-border-soft)"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 text-sm text-slate-500 md:flex-row"
      >
        <p>
          © {new Date().getFullYear()} Anthony Rojas Fuentes. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
