---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { Reveal } from "@/components/ui/Reveal";
import { TiltCard } from "@/components/ui/TiltCard";
import { ACCENTS, hexToRgba } from "@/lib/constants";
import { render } from "astro:content";

import {
  getSortedProjects,
  getSortedPublications,
  getSortedExperience,
  getSortedCertifications,
  getSortedAccomplishments,
} from "@/lib/content";

const projects = await getSortedProjects();
const publications = await getSortedPublications();
const experience = await getSortedExperience();
const certifications = await getSortedCertifications();
const accomplishments = await getSortedAccomplishments();

import ExperienceTimeline from "@/components/ExperienceTimeline";

import {
  MapPin,
  ShieldCheck,
  ArrowUpRight,
  Code2,
  FlaskConical,
  Database,
  Network,
} from "lucide-react";

import { marked } from "marked";

// Serialize experience entries with rendered HTML for the timeline island
const experienceEntries = await Promise.all(
  experience.map(async (exp) => {
    const bodyHtml = await marked.parse(exp.body || "");
    return {
      id: exp.id,
      role: exp.data.role,
      company: exp.data.company,
      period: exp.data.period,
      category: exp.data.category,
      shortDesc: exp.data.shortDesc || "",
      bodyHtml,
    };
  })
);
---

<BaseLayout title="Anthony Rojas Fuentes | Portfolio">
  {/* HERO SECTION */}
  <section id="home" class="relative flex min-h-[86vh] items-center pt-20">
    <div class="relative z-10 grid w-full items-center gap-14 md:grid-cols-2">
      <div>
        <Reveal client:load>
          <div
            class="mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1.5 font-mono text-xs"
            style={`border-color: ${hexToRgba(ACCENTS.home, 0.35)}; color: ${ACCENTS.home}; background-color: ${hexToRgba(ACCENTS.home, 0.08)}`}
          >
            <span
              class="h-1.5 w-1.5 animate-pulse rounded-full"
              style={`background-color: ${ACCENTS.home}`}></span>
            Open to works and projects
          </div>
        </Reveal>

        <Reveal client:load delay={80}>
          <h1
            class="font-display mb-5 text-4xl leading-[1.05] font-bold text-white sm:text-5xl md:text-6xl"
          >
            Anthony Rojas Fuentes
          </h1>
        </Reveal>

        <Reveal client:load delay={140}>
          <div class="mb-6 flex flex-wrap gap-2">
            <span
              class="inline-block rounded-md border border-slate-700 bg-slate-800/30 px-2.5 py-1 font-mono text-xs text-slate-300"
              >AI Engineer</span
            >
            <span
              class="inline-block rounded-md border border-slate-700 bg-slate-800/30 px-2.5 py-1 font-mono text-xs text-slate-300"
              >Data Platform Engineer</span
            >
            <span
              class="inline-block rounded-md border border-slate-700 bg-slate-800/30 px-2.5 py-1 font-mono text-xs text-slate-300"
              >Full-Stack Developer</span
            >
            <span
              class="inline-block rounded-md border border-slate-700 bg-slate-800/30 px-2.5 py-1 font-mono text-xs text-slate-300"
              >ML Scientific Researcher</span
            >
          </div>
        </Reveal>

        <Reveal client:load delay={200}>
          <p class="mb-8 max-w-lg text-lg leading-relaxed text-slate-300">
            Engineering intelligent systems and solutions through robust
            software, scalable data platforms, and production-grade AI. Driven
            by automation, grounded in computer engineering, improved with
            cutting-edge scientific research, and committed to innovation and
            technical excellence.
          </p>
        </Reveal>

        <Reveal client:load delay={320}>
          <div class="flex items-center gap-2 font-mono text-sm text-slate-400">
            <MapPin size={16} /> Alajuela, Costa Rica
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  {/* EXPERIENCE */}
  <section id="experience" class="py-20">
    <SectionHeading
      eyebrow="Career Timeline"
      title="Experience"
      color={ACCENTS.experience}
    />
    <ExperienceTimeline client:visible entries={experienceEntries} />
  </section>

  {/* PROJECTS */}
  <section id="projects" class="py-20">
    <SectionHeading
      eyebrow="Selected Work"
      title="Projects"
      color={ACCENTS.projects}
    />
    <div class="perspective-1000 grid gap-8 sm:grid-cols-1 md:grid-cols-2">
      {
        projects.map(async (p, i) => {
          const { Content } = await render(p);
          return (
            <Reveal client:visible delay={i * 100}>
              <TiltCard client:visible className="h-full w-full">
                <div
                  class="flex h-full flex-col overflow-hidden rounded-2xl border shadow-xl"
                  style="background-color: var(--color-surface); border-color: var(--color-border-soft)"
                >
                  <div
                    class="relative flex h-36 items-center justify-center overflow-hidden"
                    style="background-color: var(--color-surface-2)"
                  >
                    <div
                      class="absolute inset-0 opacity-50"
                      style={`background-image: repeating-linear-gradient(45deg, ${hexToRgba(ACCENTS.projects, 0.08)} 0px, ${hexToRgba(ACCENTS.projects, 0.08)} 1px, transparent 1px, transparent 14px)`}
                    />
                    <div
                      class="absolute h-20 w-20 rounded-full"
                      style={`background: ${hexToRgba(ACCENTS.projects, 0.2)}; filter: blur(30px)`}
                    />
                    <span
                      class="absolute top-3 right-3 z-10 rounded-full border px-2 py-1 font-mono text-[10px] uppercase backdrop-blur-sm"
                      style={`color: ${ACCENTS.projects}; border-color: ${hexToRgba(ACCENTS.projects, 0.4)}; background-color: ${hexToRgba(ACCENTS.projects, 0.1)}`}
                    >
                      {p.data.status}
                    </span>
                  </div>
                  <div class="flex flex-1 flex-col p-6">
                    <p
                      class="mb-2 font-mono text-[11px] tracking-wider uppercase"
                      style="color: var(--color-text-muted)"
                    >
                      {p.data.category}
                    </p>
                    <h3 class="font-display mb-2 text-lg font-bold text-white">
                      {p.data.title}
                    </h3>
                    <div class="mb-5 flex-1 text-sm text-slate-400">
                      <Content />
                    </div>
                    <div class="mb-5 flex flex-wrap gap-2">
                      {p.data.tech.map((t) => (
                        <span class="inline-block rounded-md border border-slate-700 bg-slate-800/30 px-2.5 py-1 font-mono text-xs text-slate-300">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </TiltCard>
            </Reveal>
          );
        })
      }
    </div>
  </section>

  {/* PUBLICATIONS */}
  <section id="publications" class="py-20">
    <SectionHeading
      eyebrow="Research & Publications"
      title="Publications"
      color={ACCENTS.publications}
    />
    <div class="flex max-w-4xl flex-col gap-6">
      {
        publications.map(async (pub, i) => {
          const { Content } = await render(pub);
          return (
            <Reveal client:visible delay={i * 100}>
              <div
                class="rounded-2xl border p-6 transition-colors hover:border-violet-500/30 md:p-7"
                style="background-color: var(--color-surface); border-color: var(--color-border-soft)"
              >
                <div class="mb-3 flex flex-wrap items-center gap-3">
                  <span
                    class="inline-block rounded-md border px-2.5 py-1 font-mono text-xs"
                    style={`color: ${ACCENTS.publications}; border-color: ${hexToRgba(ACCENTS.publications, 0.35)}; background-color: ${hexToRgba(ACCENTS.publications, 0.08)}`}
                  >
                    {pub.data.type}
                  </span>
                  <span class="flex items-center gap-1.5 font-mono text-xs text-slate-500">
                    {pub.data.venue}
                  </span>
                </div>
                <h3 class="font-display mb-2 text-xl font-bold text-white">
                  {pub.data.title}
                </h3>
                <p class="mb-3 text-sm text-slate-400">{pub.data.authors}</p>
                <div class="mb-5 leading-relaxed text-slate-300">
                  <Content />
                </div>
              </div>
            </Reveal>
          );
        })
      }
    </div>
  </section>

  {/* CERTIFICATIONS */}
  <section id="certifications" class="py-20">
    <SectionHeading
      eyebrow="Credentials"
      title="Certifications"
      color={ACCENTS.certifications}
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((cert, i) => (
          <Reveal client:visible delay={i * 80}>
            <div
              class="flex h-full flex-col rounded-2xl border p-5 transition-transform hover:-translate-y-1 hover:border-rose-500/30"
              style="background-color: var(--color-surface); border-color: var(--color-border-soft)"
            >
              <div class="mb-4 flex items-start justify-between">
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-xl shadow-inner"
                  style={`background-color: ${hexToRgba(ACCENTS.certifications, 0.12)}`}
                >
                  <ShieldCheck size={20} color={ACCENTS.certifications} />
                </span>
              </div>
              <h3 class="font-display mb-1 leading-snug font-bold text-white">
                {cert.data.name}
              </h3>
              <p class="mb-4 text-sm text-slate-400">{cert.data.issuer}</p>
            </div>
          </Reveal>
        ))
      }
    </div>
  </section>

  {/* ACCOMPLISHMENTS */}
  <section id="accomplishments" class="mb-10 py-20">
    <SectionHeading
      eyebrow="Recognition"
      title="Accomplishments"
      color={ACCENTS.accomplishments}
    />
    <div class="grid gap-4 md:grid-cols-2">
      {
        accomplishments.map(async (acc, i) => {
          const { Content } = await render(acc);
          return (
            <Reveal client:visible delay={i * 80}>
              <div
                class="flex h-full items-start gap-4 rounded-2xl border p-5 transition-transform hover:-translate-x-1 hover:border-emerald-500/30"
                style="background-color: var(--color-surface); border-color: var(--color-border-soft)"
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
                  style={`background-color: ${hexToRgba(ACCENTS.accomplishments, 0.12)}`}
                >
                  <ArrowUpRight size={18} color={ACCENTS.accomplishments} />
                </span>
                <div>
                  <h3 class="mb-1 font-medium text-white">{acc.data.title}</h3>
                  <div class="text-sm text-slate-400">
                    <Content />
                  </div>
                  {acc.data.date && (
                    <p class="mt-2 font-mono text-[10px] text-slate-600">
                      {acc.data.date}
                    </p>
                  )}
                </div>
              </div>
            </Reveal>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
